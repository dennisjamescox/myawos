[Unit]
Description=MyAWOS SDR five-click detector and connected radio transmitter
After=default.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/user/weather_station
ExecStart=/usr/bin/python3 /home/user/weather_station/click_listen.py --config /home/user/weather_station/config.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
